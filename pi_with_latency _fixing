def int2float(pcm_bytes: bytes) -> np.ndarray:
    """Convert raw int16 PCM bytes → float32 numpy array [-1, 1]."""
    return np.frombuffer(pcm_bytes, dtype=np.int16).astype(np.float32) / 32768.0


# ═══════════════════════════════════════════════════════════════
#  VAD RECORDING
# ═══════════════════════════════════════════════════════════════

def record_speech_with_vad(
    stream,
    no_speech_timeout: float = NO_SPEECH_TIMEOUT_SEC,
) -> list:
    """
    Record audio frames until:
      - VAD detects end of speech, OR
      - MAX_SPEECH_SEC reached, OR
      - no speech starts within no_speech_timeout seconds

    Returns list of raw PCM byte-frames (int16, 16 kHz mono).
    Returns empty list on timeout with no speech.
    """
    try:
        vad_iter.reset_states()
    except AttributeError:
        vad_model.reset_states()

    speech_frames  : list = []
    pre_buffer     : list = []
    speech_started  = False
    speech_ended    = False

    pre_buffer_max   = int(PRE_SPEECH_BUFFER_SEC * RATE / FRAME_LEN)
    max_frames       = int(MAX_SPEECH_SEC         * RATE / FRAME_LEN)
    no_speech_frames = int(no_speech_timeout      * RATE / FRAME_LEN)
    total_frames     = 0

    while True:
        raw    = stream.read(FRAME_LEN, exception_on_overflow=False)
        f32    = int2float(raw)
        tensor = torch.from_numpy(f32).unsqueeze(0)
        total_frames += 1

        with torch.no_grad():
            vad_out = vad_iter(tensor, return_seconds=False)

        # Rolling pre-speech buffer
        if not speech_started:
            pre_buffer.append(raw)
            if len(pre_buffer) > pre_buffer_max:
                pre_buffer.pop(0)

        # Speech start
        if vad_out and "start" in vad_out:
            speech_started = True
            speech_frames.extend(pre_buffer)
            pre_buffer = []
            print("🗣  Speech started…")

        # Accumulate frames
        if speech_started and not speech_ended:
            speech_frames.append(raw)

        # Speech end
        if vad_out and "end" in vad_out:
            speech_ended = True
            print("🔇 Speech ended.")
            break

        # Hard duration cap
        if len(speech_frames) >= max_frames:
            print(f"⏱ Max duration ({MAX_SPEECH_SEC}s) reached.")
            break

        # No-speech timeout
        if not speech_started and total_frames >= no_speech_frames:
            return []

    return speech_frames


# ═══════════════════════════════════════════════════════════════
#  STREAMING TTS PLAYBACK  (HTTP reader → Queue → Player thread)
# ═══════════════════════════════════════════════════════════════

def stream_audio_to_server(pcm_frames: list) -> bool:
    """
    1. Send PCM to Lightning AI server via streaming POST.
    2. HTTP reader puts raw chunks into a Queue.
    3. Audio player thread:
         a. Collects PRE_BUFFER_CHUNKS before opening pa_out
            (safety buffer against network jitter).
         b. Plays chunks with fixed frame alignment (no stutter).
    Returns True if audio was received and played successfully.
    """
    full_pcm = b"".join(pcm_frames)
    duration  = len(full_pcm) / (RATE * 2)
    print(f"📤 Sending {len(full_pcm)/1024:.1f} KB  ({duration:.1f}s)…")

    audio_queue : queue.Queue = queue.Queue(maxsize=QUEUE_MAXSIZE)
    got_audio   = threading.Event()   # set when HTTP reader finishes
    player_done = threading.Event()   # set when player thread exits
    error_event = threading.Event()   # set on player error

    # ─────────────────────────────────────────────────────────
    #  Audio Player Thread
    # ─────────────────────────────────────────────────────────
    def audio_player():
        # ── Phase A: Pre-buffer ───────────────────────────────
        pre_buffer_data  = b""
        chunks_collected = 0
        wait_start       = time.time()

        print("⏳ Buffering…")

        while chunks_collected < PRE_BUFFER_CHUNKS:
            if time.time() - wait_start > PRE_BUFFER_TIMEOUT:
                print("⚠ Pre-buffer timeout — starting with what we have")
                break
            try:
                chunk = audio_queue.get(timeout=1.0)
            except queue.Empty:
                if got_audio.is_set():
                    break
                continue

            if chunk is None:
                # Stream ended before pre-buffer filled
                audio_queue.put(None)   # put sentinel back for main loop
                break

            pre_buffer_data  += chunk
            chunks_collected += 1

        if not pre_buffer_data:
            print("⚠ No audio received from server.")
            player_done.set()
            return

        collected_kb = len(pre_buffer_data) / 1024
        print(f"🔊 Pre-buffered {collected_kb:.1f} KB — starting playback…")

        # ── Phase B: Open stream and play ─────────────────────
        pa_out = pa.open(
            format=pyaudio.paInt16,
            channels=1,
            rate=TTS_SAMPLE_RATE,
            output=True,
            frames_per_buffer=SAMPLES_PER_FRAME,
        )

        leftover = b""

        def write_aligned(data: bytes) -> bytes:
            """
            Write only complete BYTES_PER_FRAME blocks to pa_out.
            Returns any trailing bytes that didn't fill a full frame.
            """
            combined   = leftover + data
            n_complete = (len(combined) // BYTES_PER_FRAME) * BYTES_PER_FRAME
            if n_complete > 0:
                pa_out.write(combined[:n_complete])
            return combined[n_complete:]

        try:
            # Play pre-buffered data first
            leftover = write_aligned(pre_buffer_data)

            # Then drain the queue
            while True:
                try:
                    chunk = audio_queue.get(timeout=2.0)
                except queue.Empty:
                    if got_audio.is_set():
                        break
                    continue

                if chunk is None:
                    break

                leftover = write_aligned(chunk)

            # Flush any remaining bytes (pad to full frame)
            if leftover:
                pad_needed = BYTES_PER_FRAME - (len(leftover) % BYTES_PER_FRAME)
                if pad_needed != BYTES_PER_FRAME:
                    leftover += b"\x00" * pad_needed
                pa_out.write(leftover)

        except Exception as e:
            print(f"❌ Player error: {e}")
            error_event.set()
        finally:
            pa_out.stop_stream()
            pa_out.close()
            player_done.set()

    # ─────────────────────────────────────────────────────────
    #  HTTP Reader  (main thread)
    # ─────────────────────────────────────────────────────────
    player_thread = threading.Thread(target=audio_player, daemon=True)
    player_thread.start()

    success = False
    try:
        resp = http_session.post(
            f"{SERVER_URL}/{USER_ID}",
            data=full_pcm,
            stream=True,
            timeout=(HTTP_TIMEOUT_CONNECT, HTTP_TIMEOUT_READ),
        )
        resp.raise_for_status()

        first = True
        for chunk in resp.iter_content(chunk_size=HTTP_CHUNK_BYTES):
            if not chunk:
                continue
            if first:
                first = False
            # Backpressure: blocks if queue is full
            audio_queue.put(chunk)

        success = not first

    except requests.exceptions.Timeout:
        print("❌ Server timeout.\n")
    except requests.exceptions.ConnectionError:
        print("❌ Cannot reach server — check SERVER_URL.\n")
    except Exception as e:
        print(f"❌ HTTP error: {e}\n")
    finally:
        got_audio.set()
        audio_queue.put(None)   # sentinel to unblock player

    # Wait for player to finish before returning
    player_done.wait(timeout=30.0)

    if success and not error_event.is_set():
        print("✅ TTS playback complete.\n")

    return success and not error_event.is_set()


# ═══════════════════════════════════════════════════════════════
#  FOLLOW-UP WINDOW
# ═══════════════════════════════════════════════════════════════

def followup_listen(stream) -> list:
    """
    After TTS ends, keep mic open for FOLLOWUP_WINDOW_SEC seconds.
    Returns speech frames if user speaks, empty list on timeout.
    """
    print(f"💬 Follow-up window open ({FOLLOWUP_WINDOW_SEC}s) — speak freely…\n")

    frames = record_speech_with_vad(
        stream,
        no_speech_timeout=FOLLOWUP_WINDOW_SEC,
    )

    if not frames:
        play_beep(BEEP_LOW)
        print("⏱ Follow-up window expired — returning to wake word.\n")

    return frames


