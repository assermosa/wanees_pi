def _patched_json_schema_to_python_type(schema, defs=None):  # type: ignore
    # لو schema مش dict (زي True أو False أو None) ارجع "Any" بدل ما تقع
    if not isinstance(schema, dict):
        return "Any"
    # لو additionalProperties موجودة وهي bool كمان نعالجها
    if "additionalProperties" in schema and not isinstance(schema["additionalProperties"], dict):
        schema = {**schema, "additionalProperties": {"type": "string"}}
    return _original_json_schema_to_python_type(schema, defs)

_gc_utils._json_schema_to_python_type = _patched_json_schema_to_python_type  # type: ignore[attr-defined]

# patch get_type كمان عشان نكون safe
_original_get_type = _gc_utils.get_type  # type: ignore[attr-defined]

def _patched_get_type(schema):  # type: ignore
    if not isinstance(schema, dict):
        return "Any"
    return _original_get_type(schema)

