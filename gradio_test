async def async_asr(audio_path: str) -> str:
    """Async ASR - loads audio manually then passes numpy array"""
    loop = asyncio.get_event_loop()

    def _transcribe() -> str:
        # Load audio with torchaudio (no ffmpeg needed)
        waveform, sr = torchaudio.load(audio_path)

        # Resample to 16kHz if needed
        if sr != 16000:
            waveform = torchaudio.transforms.Resample(sr, 16000)(waveform)

        # Convert to mono
        if waveform.shape[0] > 1:
            waveform = torch.mean(waveform, dim=0, keepdim=True)

        # Convert to numpy float32
        audio_np = waveform.squeeze().numpy().astype("float32")

        # Pass numpy array directly — no ffmpeg needed
        result = asr_pipe(  # type: ignore
            {"array": audio_np, "sampling_rate": 16000}
        )
        return result["text"].strip() if isinstance(result, dict) else str(result).strip()

    return await loop.run_in_executor(None, _transcribe)
    
async def async_llm_openai(text: str) -> str:
    """Generate response using vLLM OpenAI API"""
    if openai_client is None:
        raise RuntimeError("OpenAI client not initialized")
    
    # Build messages with proper typing
    messages: List[Dict[str, str]] = [{"role": "system", "content": ELDERLY_PROMPT}]
    
    # Add conversation history
    for hist in conversation_history[-2:]:
        messages.append({"role": "user", "content": hist["user"]})
        messages.append({"role": "assistant", "content": hist["assistant"]})
    
    messages.append({"role": "user", "content": text})
    
    try:
        # Call vLLM with anti-hallucination settings
        response = await openai_client.chat.completions.create(
            model=VLLM_MODEL_NAME,
            messages=messages,  # type: ignore
            
            # Anti-hallucination parameters
            temperature=0.1,        # Low = less hallucination
            top_p=0.85,
            max_tokens=80,
            
            frequency_penalty=0.3,
            presence_penalty=0.2,
            
            stop=["User:", "user:", "المستخدم:", "###", "\n\n\n"],
        )
        
        llm_text = response.choices[0].message.content
        if llm_text is None:
            llm_text = "معلش، ما فهمتش. ممكن تعيد؟"
        
        llm_text = llm_text.strip()
        llm_text = clean_arabic_response(llm_text)
        
        return llm_text
        
    except Exception as e:
        print(f"❌ LLM error: {e}")
        return "معلش، حصلت مشكلة. ممكن تعيد تاني؟"
def complete_sentence(text: str, limit: int = 200) -> str:  # ✅ زود لـ 200
    """بتقص النص عند آخر علامة ترقيم موجودة *داخل* حدود الـ limit"""
    text = text.strip()
    
    # لو النص أصلاً أصغر من الليميت، سيبه زي ما هو
    if len(text) <= limit:
        return text
    
    # بنقص النص عند الليميت الأول
    truncated_text = text[:limit]
    
    # ندور على آخر علامة ترقيم داخل الجزء المقصوص
    last_mark = -1
    for mark in ['.', '!', '؟', '،', '؛']:
        pos = truncated_text.rfind(mark)
        if pos > last_mark:
            last_mark = pos
            
    # لو لقينا علامة ترقيم (في النص التاني من الجملة)
    if last_mark > limit // 2: 
        return truncated_text[:last_mark + 1]
    
    # لو مالقيناش، بنقص عند آخر مسافة
    last_space = truncated_text.rfind(' ')
    if last_space != -1:
        return truncated_text[:last_space]  # ✅ شيلت ".." عشان مش محتاجها في الصوت
        
    return truncated_text


async def async_tts(text: str) -> Optional[str]:
    """Async TTS with smart sentence completion"""
    if not xtts_model:
        return None
    
    loop = asyncio.get_event_loop()
    
    def _synthesize():
        # ✅ استخدم complete_sentence بـ limit = 200
        text_limited = complete_sentence(text, limit=200)
        
        with torch.inference_mode():
            out = xtts_model.inference(
                text=text_limited, 
                language="ar",
                gpt_cond_latent=gpt_cond_latent, 
                speaker_embedding=speaker_embedding,
                temperature=0.80,       
                repetition_penalty=1.3, 
                speed=0.9,              
                top_k=50,               
                top_p=0.75,             
            )

        path = tempfile.NamedTemporaryFile(delete=False, suffix=".wav").name
        torchaudio.save(path, torch.tensor(out["wav"]).unsqueeze(0), 24000)
        return path
    
    return await loop.run_in_executor(None, _synthesize)

# =================== MAIN PIPELINE ===================
async def elderly_assistant_async(audio_path: str):
    """Main pipeline"""
    if not audio_path or not os.path.exists(audio_path):
        return None, "", "", "⚠️ ما فيش صوت مسجل"
    
    total_start = time.time()
    timing = {}
    
    try:
        # ASR
        print("\n🎤 Transcribing...")
        t = time.time()
        asr_text = await async_asr(audio_path)
        timing['asr'] = time.time() - t
        print(f"📝 User: {asr_text} ({timing['asr']:.1f}s)")
        
        if not asr_text.strip():
            return None, "مفيش صوت", "", "⚠️ ما سمعتش حاجة"
        
        # LLM
        print("🧠 Generating with vLLM OpenAI...")
        t = time.time()
        llm_text = await async_llm_openai(asr_text)
        timing['llm'] = time.time() - t
        print(f"💬 Response: {llm_text} ({timing['llm']:.1f}s)")
        
        # TTS
        audio_out = None
        if xtts_model:
            t = time.time()
            audio_out = await async_tts(llm_text)
            timing['tts'] = time.time() - t
            if audio_out:
                print(f"🔊 TTS: {timing['tts']:.1f}s")
        
        timing['total'] = time.time() - total_start
        
        # Update history
        conversation_history.append({"user": asr_text, "assistant": llm_text})
        if len(conversation_history) > 6:
            conversation_history[:] = conversation_history[-6:]
        
        # Cleanup
        if torch.cuda.is_available():
            torch.cuda.empty_cache()
        gc.collect()
        
        # Summary
        tts_status = "✅ صوت" if audio_out else "⚠️ نص فقط"
        summary = f"""📊 ملخص

👤 **قلت:** {asr_text}
🤖 **رد:** {llm_text}
⏱️ **الوقت:** ASR={timing['asr']:.1f}s | LLM={timing['llm']:.1f}s | TTS={timing.get('tts',0):.1f}s | إجمالي={timing['total']:.1f}s
🔊 {tts_status}"""
        
        print(f"✅ Done: {timing['total']:.1f}s\n")
        return audio_out, asr_text, llm_text, summary
        
    except Exception as e:
        if torch.cuda.is_available():
            torch.cuda.empty_cache()
        gc.collect()
        import traceback
        traceback.print_exc()
        return None, f"❌ خطأ: {str(e)}", "", f"❌ مشكلة: {str(e)}"

def elderly_assistant_sync(audio_path):
    """Sync wrapper"""
    try:
        return asyncio.run(elderly_assistant_async(audio_path))
    except Exception as e:
        import traceback
        traceback.print_exc()
        return None, f"خطأ: {str(e)}", "", f"❌ خطأ: {str(e)}"

def clear_conversation():
